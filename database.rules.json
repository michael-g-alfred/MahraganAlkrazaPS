{
  "rules": {
    "players": {
      // Anyone can read (public leaderboard / registration view)
      ".read": true,

      // Only authenticated users can write (add / delete players)
      ".write": "auth != null",

      "$playerId": {
        // Validate the shape of every player record
        ".validate": "newData.hasChildren(['name','gender','game','stage','church','phone','birthdate','form'])"
      }
    }
  }
}
